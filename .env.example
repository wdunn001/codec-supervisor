# Copy to .env and edit for local runs. All values are optional; compose has
# sensible defaults.

# ---- supervisor ----
CODEC_PORT=8080
CODEC_LOG_LEVEL=INFO
CODEC_GPUS=1

# ---- model on first boot ----
# Local name in /models, absolute path, or HF repo id. Empty = boot supervisor
# without an active backend (use POST /admin/load to pick one later).
CODEC_INITIAL_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# ---- backend args (passed verbatim to sglang) ----
CODEC_BACKEND_ARGS=--mem-fraction-static 0.85 --attention-backend triton

# ---- HF (gated models) ----
# HF_TOKEN=hf_xxxxxxxxxxxxxxxx

# ---- build pin (for `docker compose build`) ----
CODEC_SGLANG_REF=feat/codec-server-side-agent
# CODEC_SGLANG_COMMIT=

# ---- nginx-proxy overlay (compose.nginx-proxy.yml only) ----
# VIRTUAL_HOST=codec.example.com
# LETSENCRYPT_HOST=codec.example.com
# LETSENCRYPT_EMAIL=ops@example.com

# syntax=docker/dockerfile:1.7
#
# codec/metamcp — MetaMCP gateway with the Codec binary transport patch
# applied. Drop-in for any MCP client; opt-in per-request via
# `?stream_format=msgpack` (or `protobuf`) or `Accept: application/x-codec-msgpack`.
#
# Unlike codec-{sglang,vllm,llamacpp} this image doesn't bolt on a
# Python control-plane — MetaMCP itself already ships an admin UI
# (the Next.js frontend) for namespace + server management, so there's
# nothing for codec-supervisor to add. We just build the fork.
#
# Layout closely mirrors upstream metatool-ai/metamcp's Dockerfile —
# four stages (base / deps / builder / runtime), selective runtime
# copy so the image stays close to upstream's size, non-root nextjs
# user, chmod on the entrypoint, CMD (not ENTRYPOINT) so admins can
# override with `--entrypoint sh` for debugging — same way the
# upstream image works.

ARG NODE_VERSION=22
ARG PNPM_VERSION=10.12.0
# Node 22 carries V8 12.4+ which supports the (?i:...) regex group
# syntax used by @codecai/web@0.3.0's BPETokenizer. Node 20 throws
# SyntaxError: Invalid regular expression at construction time, so
# any Codec request that touches the tokenizer (response-side text
# tokenization, args detokenize-then-encode roundtrips) fails out.

ARG CODEC_METAMCP_REPO=https://github.com/wdunn001/metamcp.git
ARG CODEC_METAMCP_REF=feat/codec-binary-transport
ARG CODEC_METAMCP_COMMIT=

# ---------- 0. base ----------
FROM node:${NODE_VERSION}-bookworm-slim AS base
ARG PNPM_VERSION

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g pnpm@${PNPM_VERSION}

WORKDIR /src

# ---------- 1. fetch the fork ----------
FROM base AS fetch
ARG CODEC_METAMCP_REPO
ARG CODEC_METAMCP_REF
ARG CODEC_METAMCP_COMMIT

RUN git clone --depth 50 --branch "${CODEC_METAMCP_REF}" "${CODEC_METAMCP_REPO}" /src/metamcp \
 && cd /src/metamcp \
 && if [ -n "${CODEC_METAMCP_COMMIT}" ]; then \
        git fetch --depth 50 origin "${CODEC_METAMCP_COMMIT}" \
        && git checkout "${CODEC_METAMCP_COMMIT}"; \
    fi \
 && git rev-parse HEAD > /src/CODEC_METAMCP_SHA \
 && git log -1 --pretty='%h %s' > /src/CODEC_METAMCP_HEAD

# ---------- 2. install + build ----------
FROM base AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=fetch /src/metamcp /app

# The Codec patch adds @msgpack/msgpack, which isn't pinned in the
# upstream pnpm-lock.yaml yet — `--no-frozen-lockfile` lets pnpm
# resolve it without rewriting the entire lockfile against a fresh
# registry snapshot. Once the PR lands and the lockfile is updated
# upstream, flip back to `--frozen-lockfile`.
RUN pnpm install --no-frozen-lockfile

RUN pnpm build

# ---------- 3. runtime ----------
FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ARG PNPM_VERSION

LABEL org.opencontainers.image.title="codec-metamcp" \
      org.opencontainers.image.description="MetaMCP with Codec binary transport (PR metatool-ai/metamcp#287)" \
      org.opencontainers.image.source="https://github.com/wdunn001/codec-supervisor" \
      org.opencontainers.image.url="https://codecai.net" \
      org.opencontainers.image.vendor="Quasarke" \
      org.opencontainers.image.licenses="Apache-2.0 AND BUSL-1.1"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl postgresql-client \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g pnpm@${PNPM_VERSION}
# postgresql-client provides `pg_isready` — upstream's
# docker-entrypoint.sh calls it in a wait-for-postgres loop before
# running drizzle migrations and spawning backend+frontend. Without
# it the entrypoint spins forever logging 'pg_isready: not found'.

# Match the upstream image's user/group so volume mounts ported from
# upstream metamcp stay compatible.
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 --home /home/nextjs nextjs \
 && mkdir -p /home/nextjs/.cache/node/corepack \
 && chown -R nextjs:nodejs /home/nextjs

WORKDIR /app

# Selective copy of the built monorepo — same shape as upstream's
# Dockerfile so the resulting image stays close in size.
COPY --from=builder --chown=nextjs:nodejs /app/apps/frontend/.next ./apps/frontend/.next
COPY --from=builder --chown=nextjs:nodejs /app/apps/frontend/package.json ./apps/frontend/
COPY --from=builder --chown=nextjs:nodejs /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder --chown=nextjs:nodejs /app/apps/backend/package.json ./apps/backend/
COPY --from=builder --chown=nextjs:nodejs /app/apps/backend/drizzle ./apps/backend/drizzle
COPY --from=builder --chown=nextjs:nodejs /app/apps/backend/drizzle.config.ts ./apps/backend/

COPY --from=builder --chown=nextjs:nodejs /app/packages ./packages
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./
COPY --from=builder --chown=nextjs:nodejs /app/pnpm-workspace.yaml ./

# Production install + drizzle-kit for runtime migrations (matches
# upstream's runtime stage). Note: `pnpm add` in pnpm 10 doesn't
# accept --no-frozen-lockfile (that flag is install-only); a fresh
# `pnpm add` is fine without it.
RUN pnpm install --prod --no-frozen-lockfile \
 && cd apps/backend && pnpm add drizzle-kit@0.31.1

# Bring the entrypoint script across, chmod it, drop privileges.
COPY --from=builder --chown=nextjs:nodejs /app/docker-entrypoint.sh ./
RUN chmod +x /app/docker-entrypoint.sh

# Stamp the fork commit so admins can verify which Codec patch this
# image was built from.
COPY --from=fetch /src/CODEC_METAMCP_SHA  /opt/codec/CODEC_METAMCP_SHA
COPY --from=fetch /src/CODEC_METAMCP_HEAD /opt/codec/CODEC_METAMCP_HEAD

USER nextjs

ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 12008

HEALTHCHECK --interval=30s --timeout=30s --start-period=2m --retries=3 \
  CMD curl -fsS http://localhost:12008/health || exit 1

CMD ["./docker-entrypoint.sh"]
